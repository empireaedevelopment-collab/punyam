# ==========================================
# PUNYAM ENVIRONMENT CONFIGURATION
# ==========================================

# --- WooCommerce / WordPress ---
# Your WordPress store URL (e.g. https://example.com)
WC_STORE_URL=https://your-wordpress-site.com
# WooCommerce REST API Consumer Key (ck_...)
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WooCommerce REST API Consumer Secret (cs_...)
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Headless WordPress API URL (Optional, defaults to mock if not set)
NEXT_PUBLIC_WORDPRESS_API_URL=https://your-wordpress-site.com/wp-json/wp/v2

# --- Razorpay Payments ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Agora Video Calling ---
NEXT_PUBLIC_AGORA_APP_ID=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_UPSTREAM_URL=https://punyam.pythonanywhere.com/api/video/agora-token/

# --- Prokerala Astrology API ---
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=

